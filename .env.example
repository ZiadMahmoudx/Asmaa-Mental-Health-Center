# =============================================================================
#  Asmaa Clinic - environment template
#  Copy to .env  ->  cp .env.example .env  ->  then fill in real values.
#  .env is git-ignored. NEVER commit real secrets or clinic wallet numbers.
# =============================================================================

# --- Database ----------------------------------------------------------------
# ONE schema serves both providers. Switch with:
#     npm run db:use:sqlserver   /   npm run db:use:postgres
# then: npm run db:generate && npm run db:push && npm run db:seed
#
# Microsoft SQL Server (2017+). A named Express instance needs TCP/IP enabled:
#     powershell -ExecutionPolicy Bypass -File .\scripts\enable-sqlserver-tcp.ps1
DATABASE_URL="sqlserver://127.0.0.1:1433;database=asmaa_clinic;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# PostgreSQL (after: npm run db:use:postgres)
# DATABASE_URL="postgresql://asmaa:CHANGE_ME@localhost:5432/asmaa_clinic?schema=public"

# --- Application -------------------------------------------------------------
# Public origin, no trailing slash. Used for CSRF origin checks and absolute links.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sessions ----------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="CHANGE_ME_generate_a_48_byte_base64_secret_value_here_ok"
# Session lifetime in days (sliding renewal handled in lib/auth/session.ts)
SESSION_TTL_DAYS="7"

# --- Receipt uploads ---------------------------------------------------------
# Directory OUTSIDE the public folder. Receipts are PHI-adjacent financial
# documents and are served only through the authorised /api/receipts route.
UPLOAD_DIR="./.uploads/receipts"
MAX_RECEIPT_BYTES="5242880"

# --- Booking policy ----------------------------------------------------------
# Minutes a slot is held for the patient before the hold expires and the slot
# is released back to the calendar.
BOOKING_HOLD_MINUTES="45"
# Minimum notice (minutes) between "now" and the earliest bookable slot.
BOOKING_MIN_NOTICE_MINUTES="120"
# How many days ahead the availability calendar is published.
BOOKING_HORIZON_DAYS="21"

# --- Manual payment destinations (shown to the patient) ----------------------
CLINIC_INSTAPAY_HANDLE="asmaaclinic@instapay"
CLINIC_VODAFONE_CASH_NUMBERS="+201001234567,+201119876543"
CLINIC_WHATSAPP_NUMBER="+201001234567"
CLINIC_NAME_AR="مركز أسما للصحة النفسية"
CLINIC_ADDRESS_AR="القاهرة الجديدة، التجمع الخامس، شارع التسعين الشمالي، مبنى المروة، الدور الثالث"
CLINIC_MAPS_URL="https://maps.google.com/?q=30.0271,31.4835"

# --- Scheduled Cron Secret ---------------------------------------------------
# Shared secret for cron endpoints (release holds, send reminders). Required (min 32 chars).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="CHANGE_ME_generate_a_32_byte_base64url_secret_here_ok"

