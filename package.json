{
  "name": "asmaa-telehealth-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:logic": "tsx --env-file=.env --conditions=react-server tests/logic.test.ts",
    "db:use:sqlserver": "node scripts/use-db-provider.mjs sqlserver",
    "db:use:postgres": "node scripts/use-db-provider.mjs postgresql",
    "verify": "npm run typecheck && npm run test:logic && npm run build",
    "dev:branch": "neon checkout dev",
    "prod:branch": "neon checkout production",
    "ship": "npm run verify && vercel deploy --prod --yes"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
